@page "/cart"

@* serverside rendering doesnt seem to load the copmponents *@
@inject CatalogApiClient CatalogApiClient
@inject BasketState BasketState

<PageTitle>Cart</PageTitle>

<img src="images/header-home.webp" width="1000" />
@if (cart == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <tbody>
            @for (int i = 0; i < cart.Count; i++)
            {              
                <tr>                    
                    <td>
                        @{
                            var item = cart[i];
                        }
                        <CartItem itemId="@item.ProductId" quantity="@item.Quantity" />                           
                    </td>
                    
                </tr>
            }
            <tr>
                <td>
                    <div style="display:flex; justify-content:space-between;">
                        <p>Total:</p>
                        <p>@TotalPrice</p>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
}

@code{
    // private List<BasketItem>? cart;
    private List<Web.Models.BasketItem>? cart;
    private decimal TotalPrice = 0;
    protected override async Task OnInitializedAsync()
    {
        await BasketState.LoadBasketAsync(); //load basket state here for now
        // cart = BasketState.GetBasketItems();
        cart = BasketState.GetBasketItems();
        TotalPrice = BasketState.GetTotalPrice();
    }

}
