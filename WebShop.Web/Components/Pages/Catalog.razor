@page "/item/{itemId:int}"
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject CatalogApiClient CatalogApiClient
@inject BasketService BasketGrpcClient

<PageTitle>Catalog</PageTitle>

<h1>Catalog Items</h1>

<p>This component demonstrates showing data loaded from a backend API service.</p>

@if (item == null)
{
    <p><em>Can't find Item</em></p>
}
else
{
    <div>
        <img src="product-images/@item.Id" alt="@item.Name" class="img-fluid" style="max-width: 100%; height: auto;" />
    </div>
    <div>
        <p>@item.Name</p>
        <p>@item.Description</p>
        <p>@item.Price</p>
        <p>@item.AvailableStock</p>
    </div>


    <div>
        <form class="add-to-cart" method="post" @formname="add-to-cart" @onsubmit="@AddToCart">
                <AntiforgeryToken />
        @if (IsAddedToCart)
        {
            <div><button name="cartBtnIncrement" @onsubmit="@IncrementCart"> + </button></div>
            <div><button name="cartBtnDecrement" @onsubmit="@DecrementCart"> - </button></div>
            <p></p>
            <div><button name="cartBtnRemove" type="submit"> Remove from Cart </button></div>
            <p>Item has been added to the cart.</p>
        }
        else
        {
            <div><button name="cartBtnAdd" @onclick="@AddToCart"> Add to Cart </button></div>
        }
        </form>
    </div>
}

@code {

    [Parameter]
    public int itemId { get; set; }
    public bool IsAddedToCart { get; set; }
    public int QtyInCart { get; set; }
    private CatalogItem? item;

    protected override async Task OnInitializedAsync()
    {
        item = await CatalogApiClient.GetItemByIdAsync(itemId);
    }

    public async Task AddToCart()
    {
        if (IsAddedToCart)
        {
            // remove all from cart
            IsAddedToCart = false;
            QtyInCart = 0;

            //remove from cart logic here
            await BasketGrpcClient.AddToBasketAsync(itemId, 0);
            return;
        }

        IsAddedToCart = true;
        QtyInCart = 1; // Assuming we add one item to the cart initially    

        //add to cart logic here
        await BasketGrpcClient.GetBasketAsync();
        // await BasketGrpcClient.AddToBasketAsync(itemId, QtyInCart);
    }

    public async Task IncrementCart()
    {
        IsAddedToCart = true;
        QtyInCart +=  1;

        //update cart logic here

    }

    public async Task DecrementCart()
    {
        IsAddedToCart = true;
        QtyInCart +=  -1;

        //update cart logic here

    }
}
