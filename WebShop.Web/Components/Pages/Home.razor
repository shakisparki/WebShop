@page "/"
@inject CatalogApiClient CatalogApi
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]


<PageTitle>Home</PageTitle>

<img src="images/header-home.webp" width="1000" />
@if (catalog == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <tbody>
            @for (int i = 0; i < catalog.Count; i += 4)
            {
                <tr>
                    @for (int j = i; j < i + 4; j++)
                    {
                        @if (j >= catalog.Count)
                        {
                            <td></td> <!-- Empty cell if there are less than 4 items -->
                            continue;
                        }
                        var item = catalog[j];
                        <td>
                            @{
                                var imageUrl = $"product-images/{item.Id}"; 
                            }

                            <div>
                                <a href="item/@item.Id">
                                    <img src="@imageUrl" alt="@item.Name" class="img-fluid" style="max-width: 100%; height: auto;" />
                                </a>
                            </div>
                            <div>
                                <p>@item.Name</p>
                                <p>@item.Description</p>
                                <p>@item.Price</p>
                                <p>@item.AvailableStock</p>
                            </div>
                            
                        </td>
                    }
                </tr>
            }

        </tbody>
    </table>
}

@code{
    private List<CatalogItem>? catalog;
    protected override async Task OnInitializedAsync()
    {
        catalog = await CatalogApi.GetAllItemsAsync();
    }

}
