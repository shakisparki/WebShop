@inject CatalogApiClient CatalogApiClient
@inject BasketState BasketState

<PageTitle>Catalog</PageTitle>

@if (QtyInCart == 0) { return; }

@if (item == null)
{
    <p><em>Can't find Item</em></p>
}
else
{
    <div style="display:flex; gap:20px;">
        <img src="product-images/@item.Id" alt="@item.Name" class="img-fluid" style="max-width: 100%; height: 150px;" />
        <div>
            <h2>@item.Name</h2>
            <p>@item.Description</p>
            <p>@item.Price</p>
            <p>Available Stock: @item.AvailableStock</p>
        </div>
    </div>



    <div>
        <form class="add-to-cart" method="post" @formname="@itemId.ToString()" @onsubmit="@AddToCart">
            <AntiforgeryToken /> 
            @if (IsAddedToCart)
            {
                <div style="display:flex; width:250px; justify-content:space-evenly">
                    <div><button name="Increment" value="1"> + </button></div>
                    <div>@QtyInCart</div>
                    <div><button name="Increment" value="-1" disabled="@(QtyInCart <= 1)"> - </button></div>
                    <p></p>
                    <div><button name="Increment" value="@(-QtyInCart)"> Remove from Cart </button></div>
                </div>
                <p>Item has been added to the cart.</p>
            }
            else
            {
                <div><button name="Increment" value="1"> Add to Cart </button></div>
            }
        </form>
    </div>
}

@code {

    [Parameter]
    public int itemId { get; set; }

    [Parameter]
    public int quantity { get; set; }

    [SupplyParameterFromForm]
    public int? Increment { get; set; }

    public bool IsAddedToCart { get; set; }
    public int QtyInCart { get; set; }
    private CatalogItem? item;

    protected override async Task OnInitializedAsync()
    {
        item = await CatalogApiClient.GetItemByIdAsync(itemId);
        if (item is not null)
        {
            QtyInCart = quantity;
            IsAddedToCart = QtyInCart > 0;
        }
    }

    public async Task AddToCart()
    {
        if (Increment is null || item is null)
        {
            return;
        }

        IsAddedToCart = true;
        QtyInCart += Increment ?? 0; // Assuming we add one item to the cart initially    

        //add to cart logic here
        if (QtyInCart <= 0)
        {
            IsAddedToCart = false;
            //remove from cart logic here
            await BasketState.RemoveItemAsync(item.Id);
        }
        else
        {
            await BasketState.UpdateItemAsync(item, Increment ?? 0);
        }        
    }
}
